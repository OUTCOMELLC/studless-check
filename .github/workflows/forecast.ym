# Refreshes data/forecast.json every 6 hours so visitors never call the weather service directly.
name: Refresh forecast

on:
  schedule:
    - cron: "17 */6 * * *"   # 00:17, 06:17, 12:17, 18:17 UTC
  workflow_dispatch:          # adds a "Run workflow" button on the Actions tab

permissions:
  contents: write

concurrency:
  group: forecast
  cancel-in-progress: false

jobs:
  refresh:
    runs-on: ubuntu-latest
    timeout-minutes: 40
    steps:
      - uses: actions/checkout@v4
      - name: Build forecast
        run: python3 scripts/build_forecast.py
      - name: Save to the repo
        run: |
          git config user.name "forecast-bot"
          git config user.email "forecast-bot@users.noreply.github.com"
          git add data/
          git diff --cached --quiet || git commit -m "Refresh forecast"
          git push
